#!/bin/sh
set -eu

PATH="/usr/bin:/bin:$PATH"
export PATH

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo "pre-commit: running ktlintCheck..."

if [ -x /bin/sh ]; then
  GRADLE_SHELL="/bin/sh"
elif command -v sh >/dev/null 2>&1; then
  GRADLE_SHELL="sh"
else
  echo "pre-commit: shell not found. Cannot run Gradle wrapper."
  exit 1
fi

if ! "$GRADLE_SHELL" ./gradlew ktlintCheck; then
  echo
  echo "pre-commit: ktlintCheck failed. Commit aborted."
  echo "pre-commit: fix issues or run one of:"
  echo "  $GRADLE_SHELL ./gradlew ktlintFormat"
  echo "  .\\gradlew.bat ktlintFormat"
  exit 1
fi

echo "pre-commit: ktlintCheck passed."
