root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
ktlint_function_naming_ignore_when_annotated_with = Composable

[shared/design-system/src/commonMain/kotlin/**/tokens/**/*.kt]
ktlint_standard_property-naming = disabled

[android/core/designsystem/src/main/java/**/*.kt]
compose_allowed_composition_locals = LocalOBRitColor,LocalOBRitTypography
